# Modelo de variáveis de ambiente do projeto.
# Copie este arquivo para ".env" e preencha com suas chaves reais.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).


# ---------------------------------------------------------------- GitHub ----
#
# São duas formas alternativas de autenticação, e basta uma.
#
# O GitHub App atende repositórios de qualquer dono: cada organização instala o
# App no repositório dela e concede as permissões. É o que a implantação usa.
# O token pessoal só alcança repositórios do próprio dono, e serve para
# desenvolvimento.

# GitHub App — "Settings > Developer settings > GitHub Apps".
GITHUB_APP_ID=

# Caminho do arquivo .pem da chave privada do App.
# A chave fica em arquivo, e não aqui, porque é um bloco PEM de várias linhas —
# formato que arquivos .env não representam bem.
# Aponte para FORA do diretório do repositório, para não haver risco de
# versioná-la por acidente.
GITHUB_APP_PRIVATE_KEY_PATH=

# Segredo do webhook, definido na mesma página do App.
# Sem ele a aplicação aceita qualquer requisição que chegue em /webhook.
GITHUB_WEBHOOK_SECRET=

# Token de acesso pessoal (https://github.com/settings/tokens).
# Alternativa ao App, para desenvolvimento.
GITHUB_TOKEN=


# ------------------------------------------------------- Modelo de linguagem ----
#
# Os padrões do config.py servem para execução local com o Ollama, e as duas
# variáveis abaixo só precisam ser definidas para mudar esse destino.

# Nome do modelo. O padrão é "marvin" — o gpt-oss:20b com a janela de contexto
# ampliada, criado a partir do Modelfile na raiz do projeto.
# Em máquina com menos de 16 GB de memória, use "marvin-7b" (Modelfile.7b).
LLM_MODELO=

# Endereço do serviço de inferência.
# O padrão é http://localhost:11434/v1/chat/completions, que é o Ollama nesta
# máquina. Trocar por um provedor de modelos abertos é só mudar este endereço.
LLM_URL=

# Só existe quando o modelo é hospedado por terceiro. Vazia, o adaptador não
# manda cabeçalho de autenticação — que é o que um executor local espera.
LLM_CHAVE=


# ------------------------------------------------------------------ Gemini ----
#
# Motor alternativo, usado pelo arranjo de avaliação com "--llm gemini".
# A aplicação não precisa dele.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
